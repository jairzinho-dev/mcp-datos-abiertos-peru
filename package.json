{
  "name": "mcp-datos-abiertos-peru",
  "version": "0.2.0",
  "description": "Servidor MCP y app Android que dan a un LLM acceso directo a la Plataforma Nacional de Datos Abiertos del Perú (datosabiertos.gob.pe)",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "mcp-datos-abiertos-peru": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "probar": "node scripts/probar.js",
    "chat": "node scripts/chat.js",
    "evaluar": "node scripts/evaluar-busqueda.js",
    "inspector": "npx @modelcontextprotocol/inspector node src/server.js",
    "app:dev": "vite",
    "app:build": "vite build",
    "app:android": "vite build && cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dompurify": "^3.5.0",
    "fflate": "^0.8.3",
    "marked": "^18.3.0",
    "pdfjs-dist": "^6.5.438",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "csv-parse": "^7.0.3",
    "vite": "^8.4.0"
  }
}
